# =====================================================================
# POSTGRESQL DATABASE CONFIGURATION
# =====================================================================
# 
# IMPORTANTE: Base de datos RAG separada e independiente
# - BD objetivo: "rag_institucional" (OBLIGATORIO)
# - BD que NO modificar: "superset" (pertenece a Superset)
# - BD que NO usar: "postgres" (BD de sistema)
#
# DESARROLLO LOCAL (Docker/devcontainer con PostgreSQL local):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=admin
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=rag_institucional
POSTGRES_SSL=disable

# EJECUCIÓN EN AZURE (PostgreSQL Flexible Server: supersetdev):
# Descomentar y usar si se ejecuta contra Azure:
# POSTGRES_HOST=supersetdev.postgres.database.azure.com
# POSTGRES_PORT=5432
# POSTGRES_USERNAME=<CONFIRMAR_USUARIO_RAG_EN_AZURE>
# POSTGRES_PASSWORD=  (dejar vacío, usar Azure Identity)
# POSTGRES_DATABASE=rag_institucional
# POSTGRES_SSL=require

# =====================================================================
# AZURE OPENAI / MICROSOFT FOUNDRY CONFIGURATION
# =====================================================================
#
# ✅ CONFIRMADO EN FASE FOUNDRY:
#
# Microsoft Foundry (Azure AI Studio):
#   - Proyecto: Proyecto-IA-UR
#   - Recurso: Modelo-IA-UR (AI Services, SKU S0)
#   - Región: East US 2
#
# Deployments creados por deploy-foundry-rag-institucional.ps1:
#   - ur-rag-gpt-5-6-luna (modelo: gpt-5.6-luna) — LLM para chat RAG
#   - ur-rag-embedding-3-large (modelo: text-embedding-3-large) — Embeddings pgvector
#
# Modo de conexión:
#   Seleccionar OPENAI_CHAT_HOST y OPENAI_EMBED_HOST según el backend deseado:
#
#   OPENAI_CHAT_HOST=foundry    → Usa Foundry (Modelo-IA-UR) para chat
#   OPENAI_CHAT_HOST=azure      → Usa Azure OpenAI (requiere recurso dedicado)
#   OPENAI_CHAT_HOST=openai     → Usa OpenAI.com directamente
#
#   OPENAI_EMBED_HOST=foundry   → Usa Foundry para embeddings
#   OPENAI_EMBED_HOST=azure     → Usa Azure OpenAI para embeddings
#   OPENAI_EMBED_HOST=openai    → Usa OpenAI.com directamente
# =====================================================================

# Selector de backend OpenAI
# Para Foundry (Modelo-IA-UR): OPENAI_CHAT_HOST=foundry, OPENAI_EMBED_HOST=foundry
# Para Azure OpenAI existente:  OPENAI_CHAT_HOST=azure,  OPENAI_EMBED_HOST=azure
# Para OpenAI.com:              OPENAI_CHAT_HOST=openai, OPENAI_EMBED_HOST=openai
OPENAI_CHAT_HOST=foundry
OPENAI_EMBED_HOST=foundry

# ────────────────────────────────────────────
# AZURE OPENAI (legacy — alternativo a Foundry)
# ────────────────────────────────────────────

# Endpoint de Azure OpenAI (usado solo si OPENAI_*_HOST=azure)
# Para Modelo-IA-UR como AI Services, el endpoint es el endpoint cognitivo
# Verificar con: az cognitiveservices account show --name Modelo-IA-UR --query properties.endpoint
AZURE_OPENAI_ENDPOINT=<CONFIRMAR_EN_AZURE>

# Deployment y modelo para chat (modo legacy azure)
AZURE_OPENAI_CHAT_DEPLOYMENT=sii-supervisor-gpt-4o-mini
AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini

# Deployment y modelo para embeddings (modo legacy azure)
AZURE_OPENAI_EMBED_DEPLOYMENT=<CONFIRMAR_EN_AZURE>
AZURE_OPENAI_EMBED_MODEL=<CONFIRMAR_EN_AZURE>
AZURE_OPENAI_EMBED_DIMENSIONS=1024
AZURE_OPENAI_EMBEDDING_COLUMN=embedding_3l

# ────────────────────────────────────────────
# FOUNDRY (Azure AI Studio — modo recomendado)
# ────────────────────────────────────────────

# Endpoint OpenAI v1 de Foundry (Modelo-IA-UR)
# Ruta: OpenAI v1 del recurso Foundry (NO es el project endpoint)
# Formato: https://<recurso>.cognitiveservices.azure.com/  (AI Services)
# Obtener: az cognitiveservices account show --name Modelo-IA-UR --query properties.endpoint
# ✅ CONFIRMADO (2026-01-09) via:
#   az cognitiveservices account show --name Modelo-IA-UR --query properties.endpoint
#   → https://modelo-ia-ur.cognitiveservices.azure.com/
FOUNDRY_OPENAI_ENDPOINT=https://modelo-ia-ur.cognitiveservices.azure.com

# Deployment y modelo para chat en Foundry
# Deployment creado por deploy-foundry-rag-institucional.ps1:
FOUNDRY_CHAT_DEPLOYMENT=ur-rag-gpt-5-6-luna
FOUNDRY_CHAT_MODEL=gpt-5.6-luna

# Deployment y modelo para embeddings en Foundry
# Deployment creado por deploy-foundry-rag-institucional.ps1:
FOUNDRY_EMBEDDING_DEPLOYMENT=ur-rag-embedding-3-large
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-large
FOUNDRY_EMBEDDING_DIMENSIONS=1024

# Deployment para evaluación (opcional)
AZURE_OPENAI_EVAL_DEPLOYMENT=<CONFIRMAR_EN_AZURE>
AZURE_OPENAI_EVAL_MODEL=<CONFIRMAR_EN_AZURE>
# =====================================================================
# AZURE AUTHENTICATION
# =====================================================================
#
# Tenant ID de Universidad del Rosario (NO es secreto, es info pública)
# Necesario para autenticación Azure Identity con PostgreSQL
# Formato: GUID de Azure Tenant
AZURE_TENANT_ID=ae525757-89ba-4d30-a2f7-49796ef8c604

# Autenticación para Azure OpenAI
# 
# OPCIONES (en orden de preferencia):
#
# 1. RECOMENDADO — Azure Identity (Managed Identity)
#    - Desarrollo local: Ejecutar `azd auth login` primero
#    - Producción (Container Apps): Managed Identity automático
#    - NUNCA guardar AZURE_OPENAI_KEY en este caso
#    - Dejar vacío:
AZURE_OPENAI_KEY=

#
# 2. TESTING SOLAMENTE — API Key-based (NUNCA en producción)
#    - NUNCA commitear keys reales a Git
#    - Para testing: usar Azure Key Vault en lugar de .env
#    - Ejemplo (NO descomenterear sin motivo válido):
#    AZURE_OPENAI_KEY=sk-proj-xxxxxxx
# =====================================================================
# ALTERNATIVA: OPENAI.COM (Local API Key)
# =====================================================================
#
# Usar si desea OpenAI.com en lugar de Azure OpenAI.
# Cambiar OPENAI_CHAT_HOST y OPENAI_EMBED_HOST a "openaicom" arriba.
#
# ⚠️ ADVERTENCIA: NUNCA guardar API keys reales en .env
# Use Azure Key Vault o secrets de CI/CD en su lugar.
#
# OPENAICOM_KEY=sk-proj-xxxxxxx
# OPENAICOM_CHAT_MODEL=gpt-3.5-turbo
# OPENAICOM_EMBED_MODEL=text-embedding-3-large
# OPENAICOM_EMBED_DIMENSIONS=1024
# OPENAICOM_EMBEDDING_COLUMN=embedding_3l

# =====================================================================
# ALTERNATIVA: OLLAMA (Local LLM)
# =====================================================================
#
# Usar si desea ejecutar LLM localmente con Ollama.
# Cambiar OPENAI_CHAT_HOST y OPENAI_EMBED_HOST a "ollama" arriba.
#
# Ollama debe estar ejecutándose en http://host.docker.internal:11434
# (desde dentro de devcontainer)
#
# OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_COLUMN=embedding_nomic

# =====================================================================
# PGVECTOR CONFIGURATION
# =====================================================================
#
# Estado actual: NO HABILITADO en supersetdev
# La extensión pgvector debe habilitarse explícitamente en Fase 3.
#
# Cuando pgvector esté habilitado:
# - Extensión será creada en BD rag_institucional
# - Tipo vector almacenará embeddings de dimensión configurada
# - Búsqueda por similitud estará disponible
#
# Variables de configuración (ya definidas en AZURE_OPENAI_*):
# - AZURE_OPENAI_EMBED_DIMENSIONS (dimensiones del vector)
# - AZURE_OPENAI_EMBEDDING_COLUMN (nombre de columna en BD)
#
# =====================================================================

# =====================================================================
# APPLICATION CONFIGURATION
# =====================================================================
#
# Indicador de ambiente
RUNNING_IN_PRODUCTION=false

# Connection string para Azure Application Insights (Monitor)
# Dejar vacío para desarrollo local
# Para Azure: Obtener de Application Insights en Azure Portal
APPLICATIONINSIGHTS_CONNECTION_STRING=

# =====================================================================
# SEGURIDAD — REGLAS OBLIGATORIAS
# =====================================================================
#
# 1. NUNCA guardar contraseñas reales en .env
#    - Use .env.local (local dev, NO commitar)
#    - Use Azure Key Vault (producción)
#    - Use secrets de CI/CD (GitHub Actions, Azure DevOps)
#
# 2. NUNCA guardar API keys en .env
#    - Use Azure Identity/Managed Identity
#    - Use Azure Key Vault
#    - Use secrets de CI/CD
#
# 3. NUNCA commitar .env a Git
#    - Agregar .env a .gitignore
#    - Solo .env.sample debe estar en Git
#    - .env.sample contiene SOLO placeholders y ejemplos
#
# 4. NUNCA usar POSTGRES_DATABASE=superset
#    - La BD superset pertenece a Apache Superset
#    - Modificarla rompe Superset
#    - SIEMPRE usar rag_institucional
#
# 5. NUNCA usar POSTGRES_DATABASE=postgres
#    - La BD postgres es BD de sistema
#    - Usarla causa problemas de estabilidad
#    - SIEMPRE usar rag_institucional
#
# =====================================================================
# DESARROLLO LOCAL — FLUJO RECOMENDADO
# =====================================================================
#
# 1. Crear archivo .env (local, NO en Git):
#    cp .env.sample .env
#
# 2. Editar .env con valores locales:
#    POSTGRES_HOST=localhost
#    POSTGRES_DATABASE=rag_institucional
#    POSTGRES_PASSWORD=postgres
#    POSTGRES_SSL=disable
#    OPENAI_CHAT_HOST=azure
#    # (otros valores según backend elegido)
#
# 3. Autenticarse en Azure:
#    azd auth login
#
# 4. Ejecutar aplicación:
#    python -m uvicorn fastapi_app:create_app --factory --reload
#
# =====================================================================
