{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend React — RAG Institucional PoC",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/frontend-poc",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
        "name": "Backend FastAPI — RAG Institucional",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/src/backend",
        "python": "D:\\environments\\rag-postgres-openai-python\\.venv\\Scripts\\python.exe",
        "module": "uvicorn",
        "args": ["fastapi_app:create_app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
        "env": {
            "PYTHONPATH": "${workspaceFolder}/src/backend"
        },
        "justMyCode": false
    },
    {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "RAG Institucional — Frontend + Backend",
      "configurations": ["Frontend React — RAG Institucional PoC", "Backend FastAPI — RAG Institucional"],
      "stopAll": true
    }
  ]
}
