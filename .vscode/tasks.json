{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend FastAPI — RAG Institucional",
            "type": "shell",
            "command": "D:\\environments\\rag-postgres-openai-python\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "uvicorn",
                "fastapi_app:create_app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload",
                "--log-level",
                "info"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/backend",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src/backend"
                },
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-NoLogo"
                    ]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false,
                "clear": true,
                "group": "rag-institucional"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(INFO|WARNING|ERROR)",
                    "endsPattern": "^(Application startup complete|Uvicorn running on)"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Frontend React — RAG Institucional PoC",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/frontend-poc",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-NoLogo"
                    ]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false,
                "clear": true,
                "group": "rag-institucional"
            },
            "dependsOn": [
                "Backend FastAPI — RAG Institucional"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(VITE|vite)",
                    "endsPattern": "^(Local|ready in|http://localhost)"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}